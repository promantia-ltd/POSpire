ISSUES.md

# Build artifacts — all regenerated by bench build on deployment
pospire/public/dist/
pospire/public/frontend/
pospire/www/pospire.html
# Service Worker assets — patched by frontend/vite-plugin-sw.js on prod build
# and mirrored into the Frappe app's www/ directory. See pospire/www/sw.py
# (and pospire/www/offline.html — copied verbatim, no Jinja content).
pospire/www/sw.js
pospire/www/offline.html
yarn.lock

# Local tarballs
*.tgz

# Claude Code session data
.claude/

# npm lock at repo root (bench manages its own)
package-lock.json

# Local CI/lint run logs
scripts/output/

# Semgrep rules cloned locally for testing — not committed
semgrep-rules/

# Playwright E2E suite — real credentials, a live session cookie, and
# generated run artifacts. Never commit these (review feedback 2026-10-20).
frontend/tests/e2e/.env.test
frontend/tests/e2e/auth.json
frontend/tests/e2e/playwright-report/
# playwright.config.ts lives in tests/e2e/ with testDir: ".", so Playwright's
# default test-results/ output folder is created there, not at frontend/'s
# own root — ignoring both locations in case of a stale run from elsewhere.
frontend/tests/e2e/test-results/
frontend/test-results/