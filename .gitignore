.DS_Store
*.pyc
*.egg-info
*.swp
tags
node_modules
__pycache__

# Local issue tracking (not committed)
ISSUES.md

# Build artifacts — all regenerated by bench build on deployment
pospire/public/dist/
pospire/public/frontend/
pospire/www/pospire.html
# Service Worker assets — patched by frontend/vite-plugin-sw.js on prod build
# and mirrored into the Frappe app's www/ directory. See pospire/www/sw.py
# (and pospire/www/offline.html — copied verbatim, no Jinja content).
pospire/www/sw.js
pospire/www/offline.html
yarn.lock

# Local tarballs
*.tgz

# Claude Code session data (shared skills are committed)
.claude/*
!.claude/skills/
# Local-only notes next to shared skills (e.g. unpublished security findings)
.claude/skills/**/*.local.md

# RCA tooling: credentials for remote sites and evidence bundles pulled from
# them (contain production customer data) must never be committed.
.env
.env.*
*.env
.envrc
*.rca.json
rca-bundles/

# npm lock at repo root (bench manages its own)
package-lock.json

# Local CI/lint run logs
scripts/output/

# Semgrep rules cloned locally for testing — not committed
semgrep-rules/