# Copy this file to `.env.test` (gitignored) and fill in a real test user
# for the target site. Never commit `.env.test` — it holds a real password.
#
# The user must have POS access (a Company + POS Profile assigned) so the
# smoke suite's opening-shift flow has something to select.

POSPIRE_E2E_BASE_URL=http://pospire_dev.localhost:8004
POSPIRE_E2E_USERNAME=administrator
POSPIRE_E2E_PASSWORD=

# Administrator's API key/secret — used by api.spec.ts / performance.spec.ts
# pure HTTP request tests (Authorization: token key:secret bypasses CSRF).
POSPIRE_E2E_API_KEY=
POSPIRE_E2E_API_SECRET=

# API key/secret for a zero-role throwaway user, used by security.spec.ts
# SEC-001 (see setup_security_test_user.py).
POSPIRE_E2E_RESTRICTED_API_KEY=
POSPIRE_E2E_RESTRICTED_API_SECRET=

# Passwords for the seeded cashiers perf.cashier01..05@pospire.test, printed
# once by pospire.pospire.tests.perf_seed.seed (see that module's docstring).
POSPIRE_E2E_PERF_PASSWORD_01=
POSPIRE_E2E_PERF_PASSWORD_02=
POSPIRE_E2E_PERF_PASSWORD_03=
POSPIRE_E2E_PERF_PASSWORD_04=
POSPIRE_E2E_PERF_PASSWORD_05=
# Least-privilege cashier perf.lowpriv@pospire.test (Sales User + POS User only).
POSPIRE_E2E_PERF_PASSWORD_LOW=
# Shared by cashiers 06..55 (CON-06 burst), created with: perf_seed.seed --kwargs {"dry_run": 0, "burst": 55}
POSPIRE_E2E_PERF_PASSWORD_BURST=
