# Copy this file to `.env.test` (gitignored — see the root .gitignore) and
# fill in a real test user for the target site. Never commit `.env.test` —
# it holds a real password and a real API secret.
#
# The user must have POS access (a Company + POS Profile assigned) so the
# smoke suite's opening-shift flow has something to select.

POSPIRE_E2E_BASE_URL=http://pospire_dev.localhost:8004
POSPIRE_E2E_USERNAME=Administrator
POSPIRE_E2E_PASSWORD=1

# Required by config-check.spec.ts — without these it `test.skip()`s every
# check and the run looks green with zero real coverage. Generate via the
# Frappe UI: User > API Access > Generate Keys.
POSPIRE_E2E_API_KEY=
POSPIRE_E2E_API_SECRET=
